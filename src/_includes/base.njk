<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>{{ title or "Field Notes" }}</title>
    <style>
      :root { color-scheme: light dark; }
      body { max-width: 70ch; margin: 3rem auto; padding: 0 1rem; font: 16px/1.6 system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif; }
      header { margin-bottom: 2rem; }
      nav a { margin-right: 1rem; }
      code, pre { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace; }
      pre { padding: 1rem; overflow-x: auto; }
    </style>
  </head>
  <body>
    <header>
      <h1 style="margin:0;">{{ title or "Field Notes" }}</h1>
      <nav>
	<a href="{{ '/' | url }}">Home</a>
	<a href="{{ '/notes/' | url }}">Notes</a>
      </nav>
    </header>
    <main>
      {{ content | safe }}
    </main>
  </body>
</html>
